# Copy this file to .env for local testing, or set these as environment
# variables on your hosting provider. NEVER commit a real .env file.
# NEVER paste these values into chat.

# From the Twilio Console dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Create in Console > Account > API keys & tokens (recommended for production).
# The access token endpoint needs an API key pair, not just SID + Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Create in Console > Voice > TwiML Apps. Set its Voice Request URL to:
#   https://YOUR-BACKEND-URL/voice
# (POST). This is what answers app calls and dials the real number.
TWILIO_TWIML_APP_SID=

# A phone number you own in Twilio (Console > Phone Numbers). This is the
# caller ID people see, and the From number for test calls.
TWILIO_PHONE_NUMBER=

# Optional, but strongly recommended in production. If set, /api/token,
# /api/calls and /api/rates require the header: x-api-key: <this value>
# Otherwise anyone who finds your backend URL could spend your Twilio balance.
BACKEND_API_KEY=

# Public URL of this backend once deployed, e.g. https://lanicall.onrender.com
# Used for call status callbacks. Leave blank for local testing.
PUBLIC_URL=

# Optional. Set to true only once PUBLIC_URL is stable, to verify Twilio
# webhook signatures on /voice.
REQUIRE_TWILIO_SIGNATURE=false

# Optional. Restrict browser origins in production, e.g. https://your-app.example
ALLOWED_ORIGIN=*

# Port is set automatically by most hosts. Local default is 3000.
PORT=3000
